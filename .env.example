POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sistema_distribuido
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Por padrão saem das portas acima; só defina se precisar de outro endereço
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# VITE_API_URL=http://localhost:8000

# Cotação do BTC (GET /cotacao): espera por fonte externa e validade do cache, em segundos.
# As fontes são públicas e não precisam de chave de API.
# COTACAO_TIMEOUT_SEGUNDOS=5
# COTACAO_CACHE_SEGUNDOS=60
